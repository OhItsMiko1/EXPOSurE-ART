{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collection Info",
  "description": "Metadata for a single artwork drop or collection",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the collection"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short description shown in collection listings"
    }
  },
  "additionalProperties": false
}
